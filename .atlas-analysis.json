  "keyFeatures": [
    "Isolated Git worktrees per task — agent edits never touch your working tree until review passes",
    "Dependency-aware sprint queues with atomic claims — parallel agents can't double-dispatch the same sprint",
    "Scope enforcement via allowed_paths — out-of-scope file edits flagged at review, not after merge",
    "Review gates with checksCmd — nothing reaches main until checks and verdict pass",
    "Parallel wave execution — independent sprints run concurrently with path-conflict detection",
    "Crash recovery — failed or runaway agents leave a resumable run, not a corrupted repo",
    "Merge-safe registry — custom Git merge driver unions agent state by ID, no conflict markers",
    "Agent-agnostic — works with Claude, Codex, Ollama, custom shell scripts, or manual mode",
    "Tracker bridge — import from and write back to Linear, Jira, GitHub Issues",
    "GitHub Actions integration — rk-validate composite action for PR gating"
  ],
